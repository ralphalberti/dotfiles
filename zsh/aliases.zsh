# Shared aliases
#
# Keep this file limited to aliases used regularly across macOS and Arch.

# ------------------------------------------------------------
# Normal files and directories
# ------------------------------------------------------------

alias files='ls -l *(.N)'
alias dir='ls -ld -- *(/N)'

# ------------------------------------------------------------
# Hidden files and directories
# ------------------------------------------------------------

alias h='ls -ld .*(N)'
alias hfiles='ls -l .*(.N)'
alias hdirs='ls -ld .*(/N)'

alias c='clear'

